# APP CONFIG
NODE_ENV=dev
PORT=8080
# Secrets used to sign JWTs — generate real random values for each
# environment (e.g. `openssl rand -hex 32`), never reuse across envs, and
# never commit the real values. SIGNKEY signs regular user tokens,
# ADMIN_KEY signs admin tokens (kept separate so a leaked user key can't be
# used to forge an admin session).
SIGNKEY=replace-with-a-long-random-value
ADMIN_KEY=replace-with-a-different-long-random-value
COOKIE_SECRET=replace-with-a-long-random-value

# DB CONFIG (MySQL — note the default port is 3306, not the Postgres 5432
# the original template shipped with)
DB_NAME=db_name
DB_PORT=3306
DB_HOST=localhost
DB_USER=username
DB_PASSWORD=password

# HOST NAME
HOST_NAME=http://localhost:8080

# Comma-separated list of exact origins allowed to make credentialed
# cross-origin requests (i.e. the web app's URL). Example:
# ALLOWED_ORIGINS=http://localhost:5173,https://app.yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173
